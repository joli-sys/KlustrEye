{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window, including the local-HTTP origin the app actually runs on.",
  "windows": [
    "main"
  ],
  "local": true,
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:default"
  ]
}
